# ============================================================
# BET CRM — variabili d'ambiente
# Copia questo file in `.env` e compila i valori.
# `.env` è già escluso dal versionamento (.gitignore).
# ============================================================

# --- Supabase (obbligatorie per la modalità reale) ---
# Le trovi in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Modalità DEMO ---
# "true"  -> forza i dati fittizi anche con Supabase configurato.
# "false" -> usa Supabase se configurato, altrimenti demo automatica.
NEXT_PUBLIC_DEMO_MODE=false

# --- API-Football (api-sports.io) ---
# ⚠️ ATTENZIONE: NIENTE prefisso NEXT_PUBLIC_.
# Deve restare esclusivamente server-side: una variabile NEXT_PUBLIC_
# finirebbe nel bundle del browser e la chiave sarebbe visibile a tutti.
# La trovi su https://dashboard.api-football.com
SPORTS_API_KEY=

# --- Amministratori ---
# Email autorizzate a usare "Aggiorna partite", separate da virgola.
# Se vuota, qualsiasi utente autenticato è considerato amministratore.
ADMIN_EMAILS=

# --- DeepSeek (predisposta, NON ancora usata) ---
# Verrà usata in una fase successiva per l'analisi automatica delle partite.
# DEEPSEEK_API_KEY=
