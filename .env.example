# ============================================================
# BET CRM — variabili d'ambiente
# Copia questo file in `.env` e compila i valori.
# `.env` è già escluso dal versionamento (.gitignore).
#
# ⚠️ Solo le variabili con prefisso NEXT_PUBLIC_ finiscono nel bundle del
# browser. TUTTE le chiavi di questo progetto sono SENZA prefisso: restano
# esclusivamente sul server.
# ============================================================

# --- Supabase (obbligatorie per la modalità reale) ---
# Le trovi in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase service role (SOLO per il job cron) ---
# ⚠️ NIENTE prefisso NEXT_PUBLIC_: bypassa la RLS e non deve mai
# raggiungere il browser. Serve al job giornaliero, che gira senza
# sessione utente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Modalità DEMO ---
# "true"  -> forza i dati fittizi anche con Supabase configurato.
# "false" -> usa Supabase se configurato, altrimenti demo automatica.
NEXT_PUBLIC_DEMO_MODE=false

# --- API-Football (api-sports.io) ---
# ⚠️ ATTENZIONE: NIENTE prefisso NEXT_PUBLIC_.
# Usata per: sync partite, aggiornamento risultati, quote reali (/odds) e
# fallback /predictions per le competizioni non coperte da OpenFootball.
# Piano Free: 100 richieste/giorno, 10 richieste/minuto.
# La trovi su https://dashboard.api-football.com
SPORTS_API_KEY=

# --- DeepSeek (analisi automatica delle partite) ---
# ⚠️ NIENTE prefisso NEXT_PUBLIC_: deve restare solo server-side.
# Chiave API di https://platform.deepseek.com
DEEPSEEK_API_KEY=

# --- Amministratori ---
# Email autorizzate alle operazioni (Aggiorna partite, Analizza, Risultati),
# separate da virgola.
# In PRODUZIONE se questa variabile è assente o vuota NESSUN utente è admin.
# In sviluppo (NODE_ENV != production) una whitelist vuota abilita tutti.
ADMIN_EMAILS=

# --- Pipeline di analisi ---
# Numero massimo di partite da analizzare per singola esecuzione.
# Default: 8
MAX_ANALYSIS_PER_RUN=

# --- Job giornaliero (Vercel Cron) ---
# Segreto condiviso: Vercel lo invia come `Authorization: Bearer <valore>`.
# Senza questa variabile l'endpoint /api/cron/daily risponde 503.
# Genera un valore casuale lungo, es. `openssl rand -hex 32`.
CRON_SECRET=

# --- Utente su cui opera il job cron ---
# UUID dell'utente Supabase proprietario dei dati (Dashboard -> Authentication).
# Il job gira con la service role, quindi deve sapere per chi lavorare.
CRON_USER_ID=
