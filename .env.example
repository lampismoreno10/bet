# ============================================================
# BET CRM — variabili d'ambiente
# Copia questo file in `.env` e compila i valori.
# `.env` è già escluso dal versionamento (.gitignore).
# ============================================================

# --- Supabase (obbligatorie per la modalità reale) ---
# Le trovi in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Modalità DEMO ---
# "true"  -> forza i dati fittizi anche con Supabase configurato.
# "false" -> usa Supabase se configurato, altrimenti demo automatica.
NEXT_PUBLIC_DEMO_MODE=false
